DATABASE_URL=postgresql://artiverse_user:artiverse_password@localhost:5432/artiverse
SECRET_KEY=your-secret-key-change-in-production-12345678

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEBUG=False
ENVIRONMENT=development

# Image storage backend: "local" (served from /uploads) or "s3"
STORAGE_BACKEND=local

# S3 / S3-compatible storage (required only when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Custom endpoint for S3-compatible providers (MinIO, DigitalOcean Spaces, ...)
S3_ENDPOINT_URL=
# Optional public base URL (CDN or bucket website) for building image URLs
S3_PUBLIC_URL=
